# Example Environment Variables (.env.example)
# WHY THIS FILE EXISTS:
# We NEVER commit real passwords (.env) to GitHub (TDD Section 8 & NFR-09).
# Instead, we commit .env.example as a template so any developer knows which environment variables they need to set up locally or in Vercel.

# 1. Supabase PostgreSQL connection string (Transaction or Session Pooler from Supabase Settings -> Database)
DATABASE_URL=postgresql+psycopg://postgres.your_project_ref:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres


# 2. MVP Demo Mode flag (FR-30):
# When true, the API accepts the 'X-Demo-User' header to switch between Researcher, Analyst, and Admin.
# In the Beta release, we set DEMO_MODE=false and use real JWT tokens instead.
DEMO_MODE=true


# 3. Allowed CORS Origins:
# Lists the frontend URLs allowed to call this backend API from a web browser.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173